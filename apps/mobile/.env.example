# Copy to .env (git-ignored). See docs/setup/accounts-and-backend.md for where each value comes from.
# Bundle identifier / Android package (optional; falls back to app.mastersettracker.dev).
APP_BUNDLE_ID=
# Supabase project URL (required). See docs/setup/accounts-and-backend.md
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (required, public). See docs/setup/accounts-and-backend.md
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google iOS OAuth client id (optional; hides Google sign-in when empty). See docs/setup/accounts-and-backend.md
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Google web OAuth client id (optional). See docs/setup/accounts-and-backend.md
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Email sign-in code length (integer 6-10, default 6). Must match Supabase → Authentication → Email → Email OTP Length.
# EXPO_PUBLIC_EMAIL_OTP_LENGTH=6
